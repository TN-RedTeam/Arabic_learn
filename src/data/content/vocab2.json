        { "type": "intro_word", "word": "اِثنان", "prompt_fr": "اِثنان (ithnān) — « deux » (2)." },
        { "type": "intro_word", "word": "ثَلاثة", "prompt_fr": "ثَلاثة (thalātha) — « trois » (3)." },
        { "type": "intro_word", "word": "أَربَعة", "prompt_fr": "أَربَعة (arbaʿa) — « quatre » (4)." },
        { "type": "intro_word", "word": "خَمسة", "prompt_fr": "خَمسة (khamsa) — « cinq » (5)." },
        { "type": "translate_choose", "prompt_fr": "Que signifie « ثَلاثة » ?", "options": ["3", "1", "5", "2"], "answer": "3" },
        { "type": "translate_choose", "prompt_fr": "Comment dit-on « quatre » ?", "options": ["أَربَعة", "خَمسة", "واحِد", "اِثنان"], "answer": "أَربَعة" },
        { "type": "intro_word", "word": "سِتّة", "prompt_fr": "سِتّة (sitta) — « six » (6)." },
        { "type": "intro_word", "word": "سَبعة", "prompt_fr": "سَبعة (sabʿa) — « sept » (7)." },
        { "type": "intro_word", "word": "ثَمانِية", "prompt_fr": "ثَمانِية (thamāniya) — « huit » (8)." },
        { "type": "intro_word", "word": "تِسعة", "prompt_fr": "تِسعة (tisʿa) — « neuf » (9)." },
        { "type": "intro_word", "word": "عَشَرة", "prompt_fr": "عَشَرة (ʿashara) — « dix » (10)." },
        { "type": "listen_choose", "prompt_fr": "Écoute et choisis le bon nombre.", "tts": "خَمسة", "options": ["خَمسة", "سَبعة", "تِسعة", "عَشَرة"], "answer": "خَمسة" },
        { "type": "match", "prompt_fr": "Associe chaque nombre.", "pairs": [ { "left": "سِتّة", "right": "6" }, { "left": "ثَمانِية", "right": "8" }, { "left": "عَشَرة", "right": "10" }, { "left": "سَبعة", "right": "7" } ] }
      ]
